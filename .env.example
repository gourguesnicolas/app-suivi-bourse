# Copie ce fichier en « .env » et colle ta clé Twelve Data (gratuite) :
# https://twelvedata.com/account/api-keys
#
# Sans clé, l'application démarre en mode démo avec des données fictives.
TWELVE_DATA_API_KEY=

# --- Facultatif ---
# Forcer le mode démo même si une clé est présente (1 = oui)
# DEMO=0

# Port et adresse d'écoute (par défaut : 3000 sur 127.0.0.1, donc visible seulement sur ton poste)
# PORT=3000
# HOST=127.0.0.1

# Durée de vie des cotes en cache pendant les heures de marché, en secondes.
# Plus elle est courte, plus tu consommes de crédits (plan gratuit : 800 par jour).
# QUOTE_TTL_SECONDS=300

# Limites du plan Twelve Data (à ajuster si tu passes à un plan payant)
# CREDITS_PER_MINUTE=8
# CREDITS_PER_DAY=800
