{
  "name": "cotes",
  "version": "1.0.0",
  "private": true,
  "description": "Suivi boursier personnel : actions, ETF, forex et crypto, avec l'API gratuite de Twelve Data.",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && tsc -p tsconfig.worker.json",
    "deploy:api": "wrangler deploy",
    "dev:api": "wrangler dev"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
